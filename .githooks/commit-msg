#!/usr/bin/env bash
# Conventional Commits, and no AI attribution (AGENTS.md, execution boundary 5).
regex="^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([a-zA-Z0-9_.-]+\))?: .+"
commit_msg=$(grep -v '^#' "$1" | head -n 1)
if [[ ! $commit_msg =~ $regex ]]; then
    echo "CricPulse: invalid commit message: '$commit_msg'"
    echo "Use: type(scope): imperative summary   e.g. feat(pipeline): add manifest upsert"
    exit 1
fi
if grep -v '^#' "$1" | grep -qiE '^(co-authored-by|claude-session):|generated with \[?claude|noreply@anthropic\.com'; then
    echo "CricPulse: AI attribution in the commit message. Remove it (AGENTS.md, boundary 5)."
    exit 1
fi
